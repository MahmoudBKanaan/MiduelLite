# Backend
PORT=3001
DATABASE_URL=postgresql://minduel:minduel@database:5432/minduel
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL (Docker Compose service "database")
POSTGRES_DB=minduel
POSTGRES_USER=minduel
POSTGRES_PASSWORD=minduel

# LiveKit — required for live spoken audio (not recording / transcription)
# Spoken audio is not recorded, not stored, and not transcribed by this app.
# Never commit real secrets; never expose keys to the frontend.
#
# Option A — managed LiveKit Cloud (recommended for real demos):
#   https://cloud.livekit.io → Project → Settings / Keys
#   LIVEKIT_URL=wss://<your-project>.livekit.cloud
#   LIVEKIT_API_KEY=...
#   LIVEKIT_API_SECRET=...
#
# Option B — local open-source LiveKit for development only:
#   docker compose --profile local-audio up -d
#   LIVEKIT_URL=ws://localhost:7880
#   LIVEKIT_API_KEY=devkey
#   LIVEKIT_API_SECRET=secret
# Default `docker compose up` does NOT start LiveKit (three app services only).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
